{
  "targets": [
    "claude",
    "codex"
  ],
  "python": "PY",
  "hook_ids": [
    "wiki-loader",
    "wiki-trigger",
    "wiki-read-log",
    "no-speculation",
    "ask-after-wiki",
    "session-capture",
    "wiki-auto-update"
  ],
  "settings_before": {
    "hooks": {
      "UserPromptSubmit": [
        {
          "hooks": [
            {
              "type": "command",
              "command": "echo user-hook",
              "timeout": 5
            }
          ]
        }
      ]
    }
  },
  "hooks_before": {
    "hooks": {
      "Stop": [
        {
          "hooks": [
            {
              "type": "command",
              "command": "echo user-stop",
              "timeout": 5
            }
          ]
        }
      ]
    }
  }
}
